<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Keys Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etOpenAiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="OpenAI API Key"
            android:inputType="textPassword"/>

        <EditText
            android:id="@+id/etAnthropicKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Anthropic API Key"
            android:inputType="textPassword"/>

        <EditText
            android:id="@+id/etGeminiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gemini API Key"
            android:inputType="textPassword"/>

        <EditText
            android:id="@+id/etGrokKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Grok API Key"
            android:inputType="textPassword"/>

        <EditText
            android:id="@+id/etRssUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="RSS URL"
            android:inputType="textUri"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnRunManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Manual Generation"/>

        <Button
            android:id="@+id/btnSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule Daily Run (8:00 AM)"/>

        <Button
            android:id="@+id/btnToggleWebView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show/Hide Note Login WebView"/>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="10"
            android:scrollbars="vertical"
            android:text="Logs will appear here..."
            android:typeface="monospace"
            android:background="#F0F0F0"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
